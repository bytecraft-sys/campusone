# Database Configuration
DATABASE_URL=postgresql+asyncpg://campusone:campusone_secret@localhost:5432/campusone_db
# For SQLite local fallback if PostgreSQL is not running:
# DATABASE_URL=sqlite+aiosqlite:///./campusone.db

# Cache and Job Queue
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-with-min-64-random-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=campusone-uploads
STORAGE_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_REGION=us-east-1

# ClamAV Virus Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Network & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Push Notifications (Firebase Cloud Messaging)
FCM_CREDENTIALS=

# AI Provider (Planned for Release 3)
AI_API_KEY=
